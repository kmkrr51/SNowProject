# Staging environment configuration
# Use this file for staging deployments

DATABASE_URL=postgresql+asyncpg://user:password@postgres-staging:5432/itsm_staging
ENVIRONMENT=staging
DEBUG=true
LOG_LEVEL=INFO
API_VERSION=v1
API_TITLE=ITSM Microservices API (Staging)
API_DESCRIPTION=Cloud-native ITSM replacement with DDD and microservices

# CORS Configuration for staging
CORS_ORIGINS=https://staging-api.itsm.example.com,https://itsm-staging.example.com,http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600
