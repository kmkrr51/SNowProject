# Production environment configuration
# Use this file for production deployments

DATABASE_URL=postgresql+asyncpg://user:password@postgres-prod:5432/itsm_prod
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING
API_VERSION=v1
API_TITLE=ITSM Microservices API
API_DESCRIPTION=Cloud-native ITSM replacement with DDD and microservices

# CORS Configuration for production
# Add your production domain and any CDN domains
CORS_ORIGINS=https://itsm.example.com,https://www.itsm.example.com,https://api.itsm.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400
